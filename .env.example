# Copy to .env.local and fill in. .env.local is gitignored.

# Local development: the dedicated container this repo expects.
#   docker run -d --name tower-builder-pg \
#     -e POSTGRES_PASSWORD=tower -e POSTGRES_USER=tower -e POSTGRES_DB=tower \
#     -p 55432:5432 -v tower-builder-pgdata:/var/lib/postgresql/data postgres:16
# Then: npm run db:migrate
DATABASE_URL=postgresql://tower:tower@127.0.0.1:55432/tower

# Production (Neon). Use the *pooled* endpoint — the host has "-pooler" in it.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ---- Stripe ---------------------------------------------------------------
# No key at all is a supported state, not a broken one. Without it the page is
# the demo it has always been: nothing is charged and #order builds floors in
# the browser, which is the state every capture in baseline/ was taken in.
# With a key and a database the client stops building floors on its own and
# they only ever appear once Stripe says the money did.
#
# Test keys start with sk_test_ and are safe to point at a local database.
STRIPE_SECRET_KEY=

# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` while
# developing, or from the endpoint's own page in the Dashboard. whsec_...
# Without it the webhook route answers 503 and the reconcile route is the only
# thing that can settle a payment.
STRIPE_WEBHOOK_SECRET=

# ---- takedown -------------------------------------------------------------
# Optional. The secret behind POST /api/admin/hide, which sets a floor's
# `hidden` flag: the storey keeps its number and keeps counting toward the
# height, and stops saying who lives there. Send it as the x-admin-secret
# header with a body of {"no": 12}. Unset, that route answers 503 and the tower
# can only be moderated from psql. There is no UI for this, on purpose.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOWER_ADMIN_SECRET=

# ---- where buyers are sent back to ----------------------------------------
# Optional. Left unset, a Checkout Session returns the buyer to the origin they
# came in on, which is what a preview deployment wants. Set it to the canonical
# origin when something in front of the app rewrites Host.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
