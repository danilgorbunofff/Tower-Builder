# Copy to .env.local and fill in. .env.local is gitignored.

# Local development: the dedicated container this repo expects.
#   docker run -d --name tower-builder-pg \
#     -e POSTGRES_PASSWORD=tower -e POSTGRES_USER=tower -e POSTGRES_DB=tower \
#     -p 55432:5432 -v tower-builder-pgdata:/var/lib/postgresql/data postgres:16
# Then: npm run db:migrate
DATABASE_URL=postgresql://tower:tower@127.0.0.1:55432/tower

# Production (Neon). Use the *pooled* endpoint — the host has "-pooler" in it.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
